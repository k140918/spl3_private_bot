# ===== 必須 =====
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# ===== メッセージ方式（AI判定）を使う場合に必須 =====
# 空のままだとメッセージ方式・両方方式は使用不可になり、Message Content Intent も要求しない
GEMINI_API_KEY=

# ===== 任意（未指定ならデフォルト値） =====
# 使用する Gemini モデル
GEMINI_MODEL=gemini-3.1-flash-lite
# 思考レベル（minimal / low / medium / high）。空ならモデル既定値
GEMINI_THINKING_LEVEL=
# Gemini API のタイムアウト秒数
GEMINI_TIMEOUT_SEC=10
# Gemini API の同時呼び出し上限
GEMINI_MAX_CONCURRENCY=3

# この confidence 以上の JOIN / LEAVE のみ反映する
AI_CONFIDENCE_THRESHOLD=0.85
# 判定時に一緒に送る直近メッセージ数
AI_CONTEXT_MESSAGES=5
# この秒数より古い発言は文脈に含めない
AI_CONTEXT_MAX_AGE_SEC=600
# これより長い発言は判定しない（API料金対策）
AI_MAX_MESSAGE_CHARS=200
# 同一ユーザーの判定間隔（秒）
AI_USER_COOLDOWN_SEC=5

# 作成からこの時間が経過した募集を自動終了する
RECRUIT_TTL_HOURS=6

# SQLite ファイルの場所（WorkingDirectory からの相対パス可）
DB_PATH=data/recruit.db

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 開発用: 指定したサーバーにだけ即時コマンド同期する（本番は空）
DEV_GUILD_ID=
